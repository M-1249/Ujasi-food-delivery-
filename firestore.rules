rules_version = '2';

/* =====================================================
   FIRESTORE SECURITY RULES — UJASI FOOD DELIVERY
   Bandika hizi kwenye Firebase Console → Firestore Database
   → Rules, kisha "Publish".

   MUHIMU: Hizi ndizo zinazohakikisha KUTENGWA KAMILI (isolation)
   kati ya wamiliki tofauti wa data - Mgahawa A HAWEZI kuona/
   kuhariri oda au menyu ya Mgahawa B, Mteja A HAWEZI kuona
   akaunti/anwani/kikapu cha Mteja B, na Rider A HAWEZI kuona
   maelezo binafsi ya Rider B. Kanuni hizi ndizo "chanzo cha
   ukweli" - UI ya mbele (front-end) haitoshi peke yake.
   ===================================================== */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Vifaa vya kusaidia ---------- */
    function signedIn() {
      return request.auth != null;
    }
    function currentRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isStaffAdmin() {
      return signedIn() && currentRole() in ["admin_layer1", "super_admin"];
    }
    function isSuperAdmin() {
      return signedIn() && currentRole() == "super_admin";
    }
    function ownsRestaurant(restaurantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid;
    }

    /* ---------- users/{uid} ----------
       Hati ya "role" ya kila mtumiaji. Mtu anasoma/anaandika
       hati YAKE tu; role haiwezi kubadilishwa baada ya kuundwa
       (huzuia mtu "kujipandisha cheo" kuwa admin mwenyewe). */
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isStaffAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    /* ---------- restaurants/{restaurantId} ----------
       Orodha ni ya UMMA kusoma (wateja wanavinjari bila kuingia),
       lakini kuandika ni MWENYE MGAHAWA HUYU TU (ownerUid == uid)
       au Admin Layer 1/Super Admin (idhini, kuzima akaunti n.k.) -
       Mgahawa A HAWEZI kubadilisha data ya Mgahawa B. */
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid || isStaffAdmin()
      );
      allow delete: if isStaffAdmin();

      match /menu/{itemId} {
        allow read: if true;
        allow write: if ownsRestaurant(restaurantId) || isStaffAdmin();
      }
    }

    /* ---------- riders/{riderId} ----------
       Rider anasoma/anaandika hati YAKE mwenyewe tu (riderId == uid
       kwa usajili mpya); Admin Layer 1/Super Admin wanaona wote
       (kwa ajili ya kugawa oda). Rider A HAWEZI kuona maelezo ya
       Rider B. */
    match /riders/{riderId} {
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isStaffAdmin());
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (resource.data.ownerUid == request.auth.uid || isStaffAdmin());
      allow delete: if isStaffAdmin();
    }

    /* ---------- customers/{uid} ----------
       Akaunti/anwani/kikapu cha MTEJA - HATI YAKE TU. Mteja A
       HAWEZI kuona akaunti ya Mteja B kwa NAMNA YOYOTE - hakuna
       "staff override" ya kusoma hapa isipokuwa Super Admin kwa
       ajili ya huduma kwa wateja (support). */
    match /customers/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isSuperAdmin();

      match /addresses/{addrId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    /* ---------- orders/{orderId} ---------- */
    match /orders/{orderId} {
      // Kusoma: MWENYE oda hii pekee (customerUid sahihi), AU wafanyakazi
      // wa mfumo (Mgahawa/Rider/Admin) wanaohitaji kuona oda kuzishughulikia.
      // Mteja MMOJA HAWEZI kufuatilia/kuona oda ya mteja MWINGINE - hata
      // akijua/kubashiri namba ya oda, isipokuwa ni yeye aliyeiweka.
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid
        || currentRole() in ["restaurant_admin", "rider", "admin_layer1", "super_admin"]
      );
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == "pending_verification";
      allow update: if signedIn() && (
        request.resource.data.status != "payment_confirmed"
        || currentRole() in ["restaurant_admin", "admin_layer1", "super_admin"]
      );
    }

    /* ---------- reviews/{reviewId} ----------
       Mteja anaunda review ya oda YAKE tu; kila mtu anasoma
       (zinaonekana kwenye ukurasa wa mgahawa); kufuta ni Admin. */
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow update: if false;
      allow delete: if isStaffAdmin();
    }

    /* ---------- promotions/{promoId} ----------
       Zinaonekana kwa wateja wote (umma); kuhariri ni Super
       Admin pekee. */
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    /* ---------- settings/{docId} ----------
       Mipangilio ya jukwaa (Lipa Namba, bei ya maji, tozo n.k.) -
       inasomwa na kila mtu aliyeingia (inahitajika kwenye
       checkout), lakini kuhaririwa ni Admin Layer 1/Super Admin
       pekee. */
    match /settings/{docId} {
      allow read: if true;
      allow write: if isStaffAdmin();
    }

    /* ---------- Kila kitu kingine: kimefungwa kwa default ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
